# Extension runtime WebSocket endpoint.
# Use ws:// for local/dev and wss:// behind Caddy/TLS.
WXT_WS_SERVER=ws://localhost:8787

# Public PWA origin used to generate /invite#... links.
WXT_PUBLIC_WEB_ORIGIN=http://localhost:4175

# Explicitly allow localhost/127.0.0.1 invite endpoints in non-dev builds.
WXT_ALLOW_LOCAL_ENDPOINTS=true

# Public web build configuration. Empty store URLs render an explicit Coming soon state.
VITE_CHROME_STORE_URL=
VITE_FIREFOX_STORE_URL=

# Accept ws://localhost and ws://127.0.0.1 invite relays in a production preview build.
# Local endpoints are always accepted by the Vite development server.
VITE_ALLOW_LOCAL_INVITES=false

# Sync server bind/listen URL.
WS_SERVER_URL=ws://0.0.0.0:8787

# Docker Compose image override for the sync server.
SYNC_SERVER_IMAGE=ghcr.io/badtochka/bsync-sync-server:latest

# Firefox MV3 add-on ID injected into browser_specific_settings.gecko.id.
# In GitHub Actions this can be configured as a repository variable or secret.
WXT_FIREFOX_EXTENSION_ID=bsync@badtochka

# Firefox Add-ons API credentials for publishing.
# In GitHub Actions keep these as repository secrets.
FIREFOX_JWT_ISSUER=
FIREFOX_JWT_SECRET=
FIREFOX_CHANNEL=listed
